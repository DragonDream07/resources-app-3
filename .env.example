# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
# Port the Express server listens on
PORT=3000

# Node environment: development | test | production
NODE_ENV=development

# ─────────────────────────────────────────────
# PostgreSQL — primary database
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=postgres
DB_PASSWORD=postgres

# ─────────────────────────────────────────────
# PostgreSQL — test database (used by jest)
# ─────────────────────────────────────────────
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=ecommerce_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# ─────────────────────────────────────────────
# JSON Web Token
# ─────────────────────────────────────────────
# Secret used to sign access tokens — keep this long and random
JWT_SECRET=change_me_to_a_long_random_string

# Access token lifetime (expressed in ms or vercel/ms string, e.g. 15m)
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime
JWT_REFRESH_EXPIRY=7d

# ─────────────────────────────────────────────
# Bcrypt
# ─────────────────────────────────────────────
# Number of salt rounds for bcrypt password hashing
BCRYPT_SALT_ROUNDS=12

# ─────────────────────────────────────────────
# Elasticsearch
# ─────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200

# Optional: Elasticsearch cloud / auth credentials
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=

# Name of the products index in Elasticsearch
ELASTICSEARCH_INDEX_PRODUCTS=products

# ─────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory where log files are written
LOG_DIR=logs

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# ─────────────────────────────────────────────
# Payment adapter
# ─────────────────────────────────────────────
# Adapter to use: mock | stripe | razorpay (only mock shipped)
PAYMENT_ADAPTER=mock

# ─────────────────────────────────────────────
# Admin seed user
# ─────────────────────────────────────────────
# Credentials used by the 02_admin_user seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
