# Frontend environment variables
# Copy this file to .env and fill in the values

# Base URL for the backend API (used by axios client)
VITE_API_BASE_URL=http://localhost:4000/api

# App title shown in the browser tab
VITE_APP_TITLE=Shop

# Optional: Razorpay / payment gateway public key
VITE_PAYMENT_KEY=

# Optional: Enable mock payment adapter in development
VITE_MOCK_PAYMENTS=true
